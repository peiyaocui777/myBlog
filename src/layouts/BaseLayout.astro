---
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title ? `${title} · aria 的博客` : 'aria 的博客 · 后端与 AI 应用工程'}</title>
  <meta name="description" content={description || '后端与 AI 应用工程实战：任务队列、并发问题定位、Agent 架构、支付链路——来自真实生产项目的经验拆解。'}>
  <meta name="theme-color" content="#FAFAF7">
  <link rel="alternate" type="application/rss+xml" title="aria 的博客" href="/rss.xml">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    :root{
      --paper:#FAFAF7; --ink:#1A1A1E; --muted:#6E6E78; --faint:#9B9BA4;
      --accent:#B4532A; --line:#E8E5DE; --code-bg:#F4F2ED;
      --serif:Georgia,"Songti SC","Noto Serif CJK SC","SimSun",serif;
      --sans:"Microsoft YaHei","PingFang SC","Noto Sans CJK SC",-apple-system,sans-serif;
      --mono:Consolas,"JetBrains Mono",Menlo,monospace;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.85;text-rendering:optimizeLegibility}

    a{color:var(--accent);text-decoration:none}
    a:hover{text-decoration:underline;text-underline-offset:3px}

    /* ===== 报头 ===== */
    .masthead{
      position:sticky;top:0;z-index:10;background:var(--paper);
      border-bottom:1px solid var(--line);
    }
    .masthead-in{
      max-width:860px;margin:0 auto;padding:18px 24px;
      display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;
    }
    .masthead .brand{font-family:var(--serif);font-size:19px;color:var(--ink);letter-spacing:.01em}
    .masthead .brand em{font-style:normal;color:var(--accent)}
    .masthead nav{display:flex;gap:22px;font-size:13.5px}
    .masthead nav a{color:var(--muted)}
    .masthead nav a:hover{color:var(--accent);text-decoration:none}
    .masthead nav a .arr{font-family:var(--mono);font-size:11px}

    .page{max-width:860px;margin:0 auto;padding:0 24px}
    main.page{min-height:70vh}

    /* ===== 首页文章列表 ===== */
    .intro{padding:64px 0 40px}
    .intro h1{font-family:var(--serif);font-size:clamp(26px,4vw,34px);font-weight:600;letter-spacing:.01em;line-height:1.4}
    .intro h1 em{font-style:normal;color:var(--accent)}
    .intro p{margin-top:14px;color:var(--muted);font-size:15px;max-width:560px}
    .post-list{list-style:none;border-top:1px solid var(--line)}
    .post-item{padding:30px 0;border-bottom:1px solid var(--line)}
    .post-item time{font-family:var(--mono);font-size:12.5px;color:var(--faint);letter-spacing:.04em}
    .post-item .rt{font-family:var(--mono);font-size:12px;color:var(--faint)}
    .post-item .rt::before{content:"·";margin:0 8px;color:var(--line)}
    .post-item h2{font-family:var(--serif);font-size:21px;font-weight:600;margin:8px 0 10px;line-height:1.45}
    .post-item h2 a{color:var(--ink)}
    .post-item h2 a:hover{color:var(--accent);text-decoration:none}
    .post-item .desc{color:var(--muted);font-size:14.5px;max-width:640px}
    .post-item .tags{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap}
    .post-item .tags span{font-family:var(--mono);font-size:11px;color:var(--faint);border:1px solid var(--line);padding:2px 8px;border-radius:2px}

    .empty-note{padding:56px 0;color:var(--faint);font-size:14px}

    /* ===== 文章页 ===== */
    article{padding:56px 0 32px}
    .post-head{max-width:680px}
    .post-meta{font-family:var(--mono);font-size:12.5px;color:var(--faint);letter-spacing:.04em;margin-bottom:16px}
    .post-meta .sep{margin:0 8px;color:var(--line)}
    article h1{font-family:var(--serif);font-size:clamp(25px,4.2vw,34px);font-weight:600;line-height:1.45;letter-spacing:.01em;margin-bottom:14px}
    .post-desc{color:var(--muted);font-size:15px;line-height:1.8;margin-bottom:0;padding-bottom:28px;border-bottom:1px solid var(--line)}
    .prose{max-width:680px;padding-top:12px;counter-reset:sec-no}
    .prose h2{
      font-family:var(--serif);font-size:22px;font-weight:600;margin:52px 0 16px;line-height:1.45;
      padding-left:14px;border-left:3px solid var(--accent);scroll-margin-top:92px;
    }
    .prose h2::before{
      counter-increment:sec-no;content:counter(sec-no,decimal-leading-zero);
      font-family:var(--mono);font-size:.62em;color:var(--faint);letter-spacing:.08em;
      margin-right:12px;vertical-align:5px;
    }
    .prose h3{font-size:17.5px;font-weight:700;margin:36px 0 12px;scroll-margin-top:92px}
    .prose p{margin:16px 0;text-wrap:pretty;letter-spacing:.015em}
    .prose ul,.prose ol{margin:16px 0 16px 4px;list-style:none}
    .prose li{margin:7px 0;padding-left:22px;position:relative}
    .prose ul li::before{
      content:"";position:absolute;left:2px;top:.72em;width:6px;height:6px;background:var(--accent);opacity:.55;
    }
    .prose ol{counter-reset:ol-item}
    .prose ol li{counter-increment:ol-item;padding-left:34px}
    .prose ol li::before{
      content:counter(ol-item);position:absolute;left:0;top:.15em;
      font-family:var(--mono);font-size:12px;color:var(--accent);line-height:1.7;
    }
    .prose blockquote{
      margin:24px 0;padding:6px 0 6px 20px;border-left:3px solid var(--accent);
      color:#55555F;font-size:15.5px;
    }
    .prose .callout{
      border-left:3px solid var(--accent);background:#F5F0E6;border-radius:0 4px 4px 0;
      padding:14px 18px;margin:22px 0;font-size:14.5px;line-height:1.8;color:#4A4640;
    }
    .prose .callout .callout-t{
      display:block;font-family:var(--mono);font-size:11px;font-weight:700;
      letter-spacing:.16em;color:var(--accent);margin-bottom:6px;
    }
    .prose .callout.warn{border-left-color:#A33B24;background:#F8EEE9}
    .prose .callout.warn .callout-t{color:#A33B24}
    .prose code{font-family:var(--mono);font-size:.85em;background:var(--code-bg);padding:2px 7px;border-radius:4px;border:1px solid var(--line)}
    .prose pre{
      position:relative;margin:24px 0;background:var(--code-bg);border:1px solid var(--line);border-radius:6px;
      padding:20px 22px;overflow-x:auto;font-size:13.5px;line-height:1.75;
    }
    .prose pre::-webkit-scrollbar{height:6px}
    .prose pre::-webkit-scrollbar-thumb{background:#DDDACF;border-radius:3px}
    .prose pre code{background:none;padding:0;border:0;font-size:inherit}
    .code-copy{
      position:absolute;top:10px;right:10px;
      font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--muted);
      background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:4px 10px;
      cursor:pointer;opacity:0;transition:opacity .15s ease;
    }
    .prose pre:hover .code-copy,.code-copy:focus-visible{opacity:1}
    .code-copy:hover{color:var(--accent);border-color:var(--accent)}
    .prose img{max-width:100%;height:auto;display:block;margin:28px auto;border:1px solid var(--line);border-radius:4px;background:#fff;padding:18px 8px}
    .prose hr{border:0;border-top:1px solid var(--line);width:96px;margin:44px auto}
    .prose table{border-collapse:collapse;margin:24px 0;font-size:14px;width:100%;display:block;overflow-x:auto}
    .prose th,.prose td{border:1px solid var(--line);padding:9px 14px;text-align:left;white-space:nowrap}
    .prose th{background:var(--code-bg);font-weight:600}
    .prose td:not(:first-child){white-space:normal;min-width:140px}
    .back{display:inline-block;margin:24px 0 60px;font-size:13.5px;color:var(--muted)}
    .back:hover{color:var(--accent)}

    /* ===== 归档 ===== */
    .archive h1,.about h1{font-family:var(--serif);font-size:28px;font-weight:600;padding:56px 0 8px}
    .archive .sub,.about .sub{color:var(--muted);font-size:14.5px;margin-bottom:36px}
    .year{font-family:var(--serif);font-size:19px;font-weight:600;margin:30px 0 6px}
    .arc-item{display:flex;gap:18px;align-items:baseline;padding:11px 0;border-bottom:1px solid var(--line)}
    .arc-item time{font-family:var(--mono);font-size:12.5px;color:var(--faint);flex:0 0 92px}
    .arc-item a{color:var(--ink)}
    .arc-item a:hover{color:var(--accent)}

    /* ===== 关于 ===== */
    .about .prose p{color:#2E2E36}
    .about-mail{font-family:var(--mono);font-size:14px;margin-top:18px}

    footer{
      margin-top:40px;border-top:1px solid var(--line);
      padding:26px 24px 40px;text-align:center;
      font-family:var(--mono);font-size:12px;color:var(--faint);letter-spacing:.05em;
    }
    footer a{color:var(--muted)}

    @media (max-width:640px){
      .masthead-in{padding:14px 18px}
      .page{padding:0 18px}
      .arc-item time{flex-basis:78px}
      .prose pre{font-size:12.5px;padding:16px 16px;border-radius:6px}
      .code-copy{opacity:1}
    }
  </style>
</head>
<body>
  <header class="masthead">
    <div class="masthead-in">
      <a class="brand" href="/">aria<em> / blog</em></a>
      <nav>
        <a href="/">首页</a>
        <a href="/archive/">归档</a>
        <a href="/about/">关于</a>
        <a href="/rss.xml">RSS</a>
        <a href="https://vorluna.top" target="_blank" rel="noopener">主页 <span class="arr">↗</span></a>
      </nav>
    </div>
  </header>
  <main class="page">
    <slot />
  </main>
  <footer>
    © 2026 aria · blog.vorluna.top · <a href="/rss.xml">RSS</a>
  </footer>
  <script>
    (function () {
      var preList = document.querySelectorAll('.prose pre');
      for (var i = 0; i < preList.length; i++) {
        (function (pre) {
          if (pre.querySelector('.code-copy')) { return; }
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.textContent = '复制';
          btn.addEventListener('click', function () {
            var codeEl = pre.querySelector('code') || pre;
            var text = codeEl.innerText;
            var done = function () {
              btn.textContent = '已复制';
              setTimeout(function () { btn.textContent = '复制'; }, 1600);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(done, done);
            } else {
              var ta = document.createElement('textarea');
              ta.value = text;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              try { document.execCommand('copy'); } catch (e) {}
              document.body.removeChild(ta);
              done();
            }
          });
          pre.appendChild(btn);
        })(preList[i]);
      }
    })();
  </script>
</body>
</html>
